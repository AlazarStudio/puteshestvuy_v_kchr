Options -MultiViews
RewriteEngine On

# Порядок правил ниже критичен — см. docs (аудит №18, пререндер + честный 404).
#
# 1) Реальные файлы и каталоги (в т.ч. dist/<path>/index.html, записанные
#    пререндером при сборке) — как есть. На Beget их до Apache вообще не
#    доводит nginx (отдаёт статику сам), условия !-f/!-d в правилах 2-4 ниже —
#    та же защита продублирована на уровне Apache (прямой заход, локальный тест).

# 2) Клиентские маршруты, которые НЕ пререндерятся (личный кабинет, вход,
#    регистрация, вся админка, служебные страницы-шаблоны услуг) — всегда
#    отдаём index.html, дальше решает сам React Router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(login|register|profile|admin(/.*)?|services/template(/.*)?)/?$ index.html [QSA,L]

# 3) URL под известными префиксами динамического контента (места, маршруты,
#    услуги, новости/статьи, события, юр. документы) вида /префикс/слаг, для
#    которых на диске ещё нет пререндер-файла, — тоже на index.html (200), а
#    не на 404. Это контент, опубликованный в админке между сборками: слаг
#    валиден, но статический файл появится только при следующем build:full —
#    до этого страницу обязана отрисовать сама SPA.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(places|routes|services|news|events|legal)/[^/]+/?$ index.html [QSA,L]

# 4) Всё остальное, чего нет на диске, — честный 404 (не index.html: раньше
#    любой битый адрес отдавал 200 с SPA-заглушкой, из-за чего робот не мог
#    отличить реальную страницу от опечатки в ссылке).
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]

# Dev-контур: dev.* — алиас того же docroot, что и боевые домены.
# Страницам dev-хоста ставим запрет индексации (боевых хостов не касается:
# заголовок вешается только при совпадении Host с ^dev\.).
# Правильное закрытие двойника — отключить поддомен dev в панели Beget,
# это подстраховка на уровне файлов. См. docs/deploy/dev-contour.md
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host ^dev\. DEV_HOST
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=DEV_HOST

  # Защитные заголовки (аудит, раздел 07). Beget отдаёт статику через nginx
  # мимо Apache, поэтому заголовки применяются к страницам (SPA-маршрутам) —
  # для HSTS и антифрейминга этого достаточно. CSP вводим отдельно, когда
  # соберём список сторонних доменов (Jivo, Translate, lidrekon, карты).
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
